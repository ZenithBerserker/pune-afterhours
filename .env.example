# Copy to .env.local and fill in values from Supabase Dashboard → Settings → API
# Never commit .env.local or paste the service role key in chat.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Required with Supabase: used for Auth (browser + middleware + Route Handlers). Not secret like the service role, but expose only in trusted clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Server-side API reads/writes (bypasses RLS). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
